{
  "name": "idempotent-webhook-ingestion",
  "version": "0.0.0",
  "description": "An idempotent webhook ingestion service that stores each signed event at most once despite retries and is tested under up to 10,000 requests per second.",
  "homepage": "https://github.com/fernando-gap/idempotent-webhook-ingestion#readme",
  "bugs": {
    "url": "https://github.com/fernando-gap/idempotent-webhook-ingestion/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernando-gap/idempotent-webhook-ingestion.git"
  },
  "license": "Apache-2.0",
  "author": "Augusto G.",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npx vitest",
    "test:coverage": "vitest run --coverage",
    "schemas:compile": "npx json2ts -i src/schemas -o src/types"
  },
  "dependencies": {
    "@fastify/type-provider-json-schema-to-ts": "^5.0.0",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tsdoc": "^0.5.2",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
